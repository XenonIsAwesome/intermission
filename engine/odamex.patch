diff --git a/client/sdl/i_linuxmouse.cpp b/client/sdl/i_linuxmouse.cpp
new file mode 100644
index 000000000..d86cb1866
--- /dev/null
+++ b/client/sdl/i_linuxmouse.cpp
@@ -0,0 +1,333 @@
+// Mouse capture for the intermission Claude Code mod on Linux.
+//
+// A terminal can't capture the mouse and this process has no window, so it
+// holds the pointer itself, in one of two ways:
+//
+//   X11      Each tic the pointer's distance from where it was locked becomes
+//            motion, and it is put back. The cursor is hidden while locked.
+//            Esc or Super releases it.
+//   evdev    Wayland lets no program hold or even read the pointer, so the
+//            mouse's own events are read from /dev/input, which needs
+//            membership of the input group. The cursor stays visible and free.
+//
+// Neither X11 nor its extensions are linked: they are loaded when first needed,
+// so a machine without them still runs the game.
+
+#include "i_linuxmouse.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <dirent.h>
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <linux/input.h>
+#include <string>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <vector>
+
+#include <X11/Xlib.h>
+#include <X11/extensions/Xfixes.h>
+#include <X11/keysym.h>
+
+namespace LinuxMouse
+{
+namespace
+{
+
+// A count from a mouse is a smaller step than a pixel the pointer moved
+const double EVDEV_PER_PIXEL = 0.5;
+
+struct Backend
+{
+	virtual ~Backend() {}
+	virtual bool lock(const char** why) = 0;
+	virtual void release() = 0;
+	virtual int take(bool* released) = 0;
+};
+
+// ---- X11 --------------------------------------------------------------------
+
+struct X11Backend : Backend
+{
+	void* libX11 = nullptr;
+	void* libXfixes = nullptr;
+	Display* display = nullptr;
+	Window root = 0;
+	int lockedX = 0, lockedY = 0;
+	bool isHidden = false;
+	KeyCode escape = 0;
+
+	Display* (*openDisplay)(const char*);
+	Window (*defaultRoot)(Display*);
+	Bool (*queryPointer)(Display*, Window, Window*, Window*, int*, int*, int*, int*, unsigned*);
+	int (*warpPointer)(Display*, Window, Window, int, int, unsigned, unsigned, int, int);
+	int (*flush)(Display*);
+	int (*queryKeymap)(Display*, char[32]);
+	KeyCode (*keysymToKeycode)(Display*, KeySym);
+	void (*hideCursor)(Display*, Window);
+	void (*showCursor)(Display*, Window);
+
+	template <class T> bool bind(void* lib, T& fn, const char* name)
+	{
+		fn = reinterpret_cast<T>(dlsym(lib, name));
+		return fn != nullptr;
+	}
+
+	bool open()
+	{
+		if (!getenv("DISPLAY"))
+			return false;
+		libX11 = dlopen("libX11.so.6", RTLD_LAZY);
+		libXfixes = dlopen("libXfixes.so.3", RTLD_LAZY);
+		if (!libX11 || !libXfixes)
+			return false;
+		if (!bind(libX11, openDisplay, "XOpenDisplay") ||
+		    !bind(libX11, defaultRoot, "XDefaultRootWindow") ||
+		    !bind(libX11, queryPointer, "XQueryPointer") ||
+		    !bind(libX11, warpPointer, "XWarpPointer") || !bind(libX11, flush, "XFlush") ||
+		    !bind(libX11, queryKeymap, "XQueryKeymap") ||
+		    !bind(libX11, keysymToKeycode, "XKeysymToKeycode") ||
+		    !bind(libXfixes, hideCursor, "XFixesHideCursor") ||
+		    !bind(libXfixes, showCursor, "XFixesShowCursor"))
+			return false;
+		display = openDisplay(nullptr);
+		if (!display)
+			return false;
+		root = defaultRoot(display);
+		escape = keysymToKeycode(display, XK_Escape);
+		return true;
+	}
+
+	bool pointer(int* x, int* y, unsigned* mask)
+	{
+		Window rootReturn, child;
+		int wx, wy;
+		return queryPointer(display, root, &rootReturn, &child, x, y, &wx, &wy, mask);
+	}
+
+	bool lock(const char** why) override
+	{
+		unsigned mask;
+		if (!pointer(&lockedX, &lockedY, &mask))
+		{
+			*why = "the X server wouldn't say where the mouse is";
+			return false;
+		}
+		if (!isHidden)
+		{
+			// X counts hides, so hide once per lock and show once per release
+			hideCursor(display, root);
+			isHidden = true;
+		}
+		flush(display);
+		return true;
+	}
+
+	void release() override
+	{
+		if (isHidden)
+		{
+			showCursor(display, root);
+			isHidden = false;
+			flush(display);
+		}
+	}
+
+	int take(bool* released) override
+	{
+		int x, y;
+		unsigned mask;
+		if (!pointer(&x, &y, &mask))
+			return 0;
+		char keys[32];
+		queryKeymap(display, keys);
+		if ((escape && (keys[escape / 8] & (1 << (escape % 8)))) || (mask & Mod4Mask))
+		{
+			*released = true;
+			return 0;
+		}
+		if (x == lockedX && y == lockedY)
+			return 0;
+		warpPointer(display, 0, root, 0, 0, 0, 0, lockedX, lockedY);
+		flush(display);
+		return x - lockedX;
+	}
+};
+
+// ---- evdev ------------------------------------------------------------------
+
+struct EvdevBackend : Backend
+{
+	std::vector<int> fds;
+	bool isLocked = false;
+
+	static bool has(int fd, int type, int code)
+	{
+		unsigned char bits[KEY_MAX / 8 + 1];
+		memset(bits, 0, sizeof(bits));
+		if (ioctl(fd, EVIOCGBIT(type, sizeof(bits)), bits) < 0)
+			return false;
+		return bits[code / 8] & (1 << (code % 8));
+	}
+
+	// Number of device files that exist, so no access to any can be told from
+	// a machine with no mouse
+	int seen = 0;
+
+	bool open()
+	{
+		DIR* dir = opendir("/dev/input");
+		if (!dir)
+			return false;
+		while (dirent* entry = readdir(dir))
+		{
+			if (strncmp(entry->d_name, "event", 5) != 0)
+				continue;
+			seen++;
+			const std::string path = std::string("/dev/input/") + entry->d_name;
+			const int fd = ::open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+			if (fd < 0)
+				continue;
+			const bool isMouse = has(fd, EV_REL, REL_X);
+			const bool isKeyboard = has(fd, EV_KEY, KEY_ESC) && has(fd, EV_KEY, KEY_A);
+			if (isMouse || isKeyboard)
+				fds.push_back(fd);
+			else
+				::close(fd);
+		}
+		closedir(dir);
+		return !fds.empty();
+	}
+
+	~EvdevBackend()
+	{
+		for (const int fd : fds)
+			::close(fd);
+	}
+
+	int drain(bool* released)
+	{
+		int motion = 0;
+		input_event events[64];
+		for (const int fd : fds)
+		{
+			for (;;)
+			{
+				const ssize_t n = read(fd, events, sizeof(events));
+				if (n <= 0)
+					break;
+				for (size_t i = 0; i < size_t(n) / sizeof(input_event); i++)
+				{
+					const input_event& e = events[i];
+					if (e.type == EV_REL && e.code == REL_X)
+						motion += e.value;
+					else if (e.type == EV_KEY && e.value == 1 &&
+					         (e.code == KEY_ESC || e.code == KEY_LEFTMETA || e.code == KEY_RIGHTMETA))
+						*released = true;
+				}
+			}
+		}
+		return motion;
+	}
+
+	bool lock(const char** why) override
+	{
+		if (fds.empty())
+		{
+			*why = seen ? "reading the mouse needs your user in the input group"
+			            : "no input devices to read the mouse from";
+			return false;
+		}
+		// Whatever happened before the click isn't turning
+		bool ignored = false;
+		drain(&ignored);
+		isLocked = true;
+		return true;
+	}
+
+	void release() override { isLocked = false; }
+
+	int take(bool* released) override
+	{
+		return int(drain(released) * EVDEV_PER_PIXEL);
+	}
+};
+
+Backend* backend = nullptr;
+bool isTried = false;
+std::string reason;
+bool isLockedNow = false;
+
+bool isWayland()
+{
+	const char* session = getenv("XDG_SESSION_TYPE");
+	return (session && !strcmp(session, "wayland")) || getenv("WAYLAND_DISPLAY");
+}
+
+Backend* choose(const char** why)
+{
+	// On Wayland an X11 client only sees the pointer over X11 windows, which a
+	// terminal usually isn't, so only the mouse's own events will do there
+	if (!isWayland())
+	{
+		X11Backend* x = new X11Backend();
+		if (x->open())
+			return x;
+		delete x;
+	}
+	EvdevBackend* e = new EvdevBackend();
+	if (e->open())
+		return e;
+	*why = e->seen ? "reading the mouse needs your user in the input group"
+	               : "no input devices to read the mouse from";
+	delete e;
+	return nullptr;
+}
+
+} // namespace
+
+bool Lock(const char** why)
+{
+	if (!isTried)
+	{
+		isTried = true;
+		const char* found = "no way to read the mouse here";
+		backend = choose(&found);
+		reason = found;
+	}
+	if (!backend)
+	{
+		*why = reason.c_str();
+		return false;
+	}
+	if (isLockedNow)
+		return true;
+	if (!backend->lock(why))
+		return false;
+	isLockedNow = true;
+	return true;
+}
+
+void Release()
+{
+	if (!isLockedNow)
+		return;
+	backend->release();
+	isLockedNow = false;
+}
+
+bool IsLocked()
+{
+	return isLockedNow;
+}
+
+int TakeMotion(bool* released)
+{
+	*released = false;
+	if (!isLockedNow)
+		return 0;
+	return backend->take(released);
+}
+
+} // namespace LinuxMouse
