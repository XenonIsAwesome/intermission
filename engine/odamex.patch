diff --git a/client/sdl/i_inputfile.cpp b/client/sdl/i_inputfile.cpp
new file mode 100644
index 000000000..ce8e9b6f1
--- /dev/null
+++ b/client/sdl/i_inputfile.cpp
@@ -0,0 +1,319 @@
+// Reads input from the intermission Claude Code mod.
+//
+// A terminal reports key presses but never releases, so the mod works out
+// which keys count as held and writes that state, not a stream of events, to
+// the file INTERMISSION_INPUT names. The file holds one line:
+//
+//   <playing> <clicks> <key> <key> ...
+//
+// where playing is 0 while the person is handed back to Claude, clicks counts
+// the clicks on the game so far, and each key is an Odamex key code held right
+// now. Each tic the changes are posted as Doom events. Without the variable
+// this does nothing.
+//
+// Between drop-ins the engine stays connected as a silent spectator, so
+// dropping back in is instant and nobody is left standing in the open. In an
+// offline game, with no server to spectate on, it pauses instead.
+//
+// A terminal can't capture the mouse either, but a native process can hold
+// the cursor itself: each click locks it where it landed, and every tic the
+// distance it travelled becomes mouse motion before it is put back. That needs
+// no window and no permission. Esc or Command releases it, so leaving the game
+// or switching apps never drags a locked cursor along. While locked the cursor
+// is hidden; macOS shows it again if this process dies. On Linux, see
+// i_linuxmouse.cpp; Super takes the place of Command.
+//
+// INTERMISSION_SENSITIVITY scales all turning. The arrow keys turn through the
+// same path as the mouse, steadily and by the same scale, instead of at Doom's
+// fixed keyboard rate.
+
+#include "odamex.h"
+
+#include "i_inputfile.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <set>
+#include <unistd.h>
+
+#include "c_cvars.h"
+#include "c_dispatch.h"
+#include "cl_main.h"
+#include "d_main.h"
+#include "d_player.h"
+#include "doomstat.h"
+
+#ifdef __linux__
+#include "i_linuxmouse.h"
+#endif
+
+EXTERN_CVAR(snd_sfxvolume)
+EXTERN_CVAR(snd_musicvolume)
+
+static bool isPlaying = true;
+
+// Mouse motion per pixel the mouse moved, and per tic an arrow key is held,
+// both before the person's sensitivity
+static const double MOUSE_PER_PIXEL = 3.0;
+static const double TURN_PER_TIC = 60.0;
+static const int KEY_LEFT_ARROW = 0x40000050;
+static const int KEY_RIGHT_ARROW = 0x4000004f;
+
+static double sensitivity()
+{
+	static double value = -1;
+	if (value < 0)
+	{
+		const char* text = getenv("INTERMISSION_SENSITIVITY");
+		value = text ? atof(text) : 1.0;
+		value = std::min(10.0, std::max(0.05, value > 0 ? value : 1.0));
+	}
+	return value;
+}
+
+bool I_IsPlaying()
+{
+	return isPlaying;
+}
+
+static void postEvent(const event_t& ev)
+{
+	D_PostEvent(&ev);
+}
+
+#ifdef __APPLE__
+
+#include <ApplicationServices/ApplicationServices.h>
+
+static const CGKeyCode KEY_ESCAPE = 53;
+
+static bool isLocked = false;
+static CGPoint lockedAt;
+
+static CGPoint cursorPosition()
+{
+	CGEventRef event = CGEventCreate(NULL);
+	const CGPoint point = CGEventGetLocation(event);
+	CFRelease(event);
+	return point;
+}
+
+// Undocumented, and the only way a process that isn't the frontmost app can
+// hide the cursor. If a macOS release drops it, the cursor simply stays shown.
+typedef int CGSConnectionID;
+extern "C" CGSConnectionID _CGSDefaultConnection(void);
+extern "C" CGError CGSSetConnectionProperty(CGSConnectionID, CGSConnectionID, CFStringRef, CFTypeRef);
+
+static void prepareCursor()
+{
+	static bool isPrepared = false;
+	if (isPrepared)
+		return;
+	// After a warp macOS ignores the mouse for a moment unless told not to
+	CGEventSourceRef source = CGEventSourceCreate(kCGEventSourceStateCombinedSessionState);
+	CGEventSourceSetLocalEventsSuppressionInterval(source, 0.0);
+	CFRelease(source);
+	const CGSConnectionID connection = _CGSDefaultConnection();
+	CGSSetConnectionProperty(connection, connection, CFSTR("SetsCursorInBackground"), kCFBooleanTrue);
+	isPrepared = true;
+}
+
+static void lockMouse()
+{
+	if (isLocked)
+		return;
+	prepareCursor();
+	// A warp to a fractional point lands on a whole one, which would read as motion
+	const CGPoint point = cursorPosition();
+	lockedAt = CGPointMake(round(point.x), round(point.y));
+	// macOS counts hides, so hide once per lock and show once per release
+	CGDisplayHideCursor(kCGDirectMainDisplay);
+	isLocked = true;
+}
+
+static void releaseMouse()
+{
+	if (!isLocked)
+		return;
+	CGDisplayShowCursor(kCGDirectMainDisplay);
+	isLocked = false;
+}
+
+static void postLockedMotion()
+{
+	if (!isLocked)
+		return;
+	const CGEventFlags flags = CGEventSourceFlagsState(kCGEventSourceStateCombinedSessionState);
+	if (CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, KEY_ESCAPE) ||
+		(flags & kCGEventFlagMaskCommand))
+	{
+		releaseMouse();
+		return;
+	}
+	const CGPoint point = cursorPosition();
+	if (point.x == lockedAt.x && point.y == lockedAt.y)
+		return;
+	CGWarpMouseCursorPosition(lockedAt);
+	const int motion = (int)lround((point.x - lockedAt.x) * MOUSE_PER_PIXEL * sensitivity());
+	if (motion)
+		postEvent(event_t(ev_mouse, 0, motion, 0));
+}
+
+#elif defined(__linux__)
+
+static void lockMouse()
+{
+	static bool isReported = false;
+	const char* why = "";
+	if (LinuxMouse::Lock(&why) || isReported)
+		return;
+	// Once, so the mod can say why the mouse isn't turning
+	isReported = true;
+	printf("@mouse %s\n", why);
+	fflush(stdout);
+}
+
+static void releaseMouse()
+{
+	LinuxMouse::Release();
+}
+
+static void postLockedMotion()
+{
+	if (!LinuxMouse::IsLocked())
+		return;
+	bool isReleased = false;
+	const int motion = (int)lround(LinuxMouse::TakeMotion(&isReleased) * MOUSE_PER_PIXEL * sensitivity());
+	if (isReleased)
+		LinuxMouse::Release();
+	else if (motion)
+		postEvent(event_t(ev_mouse, 0, motion, 0));
+}
+
+#else
+
+static void lockMouse() {}
+static void releaseMouse() {}
+static void postLockedMotion() {}
+
+#endif
+
+// The arrow keys held right now, turning as the mouse does
+static int turnDirection = 0;
+
+static void postKeyTurn()
+{
+	if (isPlaying && turnDirection)
+		postEvent(event_t(ev_mouse, 0, (int)lround(turnDirection * TURN_PER_TIC * sensitivity()), 0));
+}
+
+static void setPlaying(bool isNowPlaying)
+{
+	static float sfxVolume = 0;
+	static float musicVolume = 0;
+	if (isNowPlaying == isPlaying)
+		return;
+	isPlaying = isNowPlaying;
+	if (isPlaying)
+	{
+		snd_sfxvolume.Set(sfxVolume);
+		snd_musicvolume.Set(musicVolume);
+	}
+	else
+	{
+		sfxVolume = snd_sfxvolume.value();
+		musicVolume = snd_musicvolume.value();
+		snd_sfxvolume.Set(0.0f);
+		snd_musicvolume.Set(0.0f);
+		releaseMouse();
+	}
+}
+
+// A join, spectate or pause takes effect a moment later, so keep nudging the
+// game towards what the mod wants, once a second, until it gets there
+static void followPlaying()
+{
+	static int ticsUntilAsking = 0;
+	if (--ticsUntilAsking > 0)
+		return;
+	if (connected)
+	{
+		const bool isSpectating = consoleplayer().spectator;
+		if (isPlaying && isSpectating)
+			AddCommandString("join");
+		else if (!isPlaying && !isSpectating)
+			AddCommandString("spectate");
+		else
+			return;
+	}
+	// The pause command toggles, so only send it while the state is wrong
+	else if (gamestate == GS_LEVEL && paused == isPlaying)
+		AddCommandString("pause");
+	else
+		return;
+	ticsUntilAsking = TICRATE;
+}
+
+void I_ReadInputFile()
+{
+	static const char* path = getenv("INTERMISSION_INPUT");
+	static const pid_t claudeCode = getppid();
+	static std::set<int> held;
+	static long clicks = 0;
+	if (!path)
+		return;
+
+	// Claude Code stops the engine when it no longer needs it, but not if it
+	// dies first, say with its terminal tab; then this process is handed to
+	// another parent and should quit rather than play on unseen.
+	if (getppid() != claudeCode || getppid() == 1)
+		exit(0);
+
+	postLockedMotion();
+	postKeyTurn();
+	followPlaying();
+
+	char line[1024];
+	FILE* file = fopen(path, "r");
+	const bool isRead = file && fgets(line, sizeof(line), file);
+	if (file)
+		fclose(file);
+
+	// The mod rewrites the file in place, so a line without its newline is a
+	// write in progress: keep the last state until the next tic.
+	if (!isRead || !strchr(line, '\n'))
+		return;
+
+	char* cursor = line;
+	setPlaying(strtol(cursor, &cursor, 10) != 0);
+	const long nextClicks = strtol(cursor, &cursor, 10);
+	std::set<int> next;
+	for (char* end; ; cursor = end)
+	{
+		const long key = strtol(cursor, &end, 10);
+		if (end == cursor)
+			break;
+		next.insert((int)key);
+	}
+
+	// A new input region counts from zero again, so any change is a new click
+	if (isPlaying && nextClicks != clicks && nextClicks > 0)
+		lockMouse();
+	clicks = nextClicks;
+
+	turnDirection = (int)next.count(KEY_RIGHT_ARROW) - (int)next.count(KEY_LEFT_ARROW);
+	// The arrows turn through postKeyTurn, not as keys
+	next.erase(KEY_LEFT_ARROW);
+	next.erase(KEY_RIGHT_ARROW);
+
+	for (const int key : held)
+		if (!next.count(key))
+			postEvent(event_t(ev_keyup, key));
+	for (const int key : next)
+		if (!held.count(key))
+			postEvent(event_t(ev_keydown, key));
+	held = next;
+}
